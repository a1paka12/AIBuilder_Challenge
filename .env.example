# 서버 전용 환경 변수 (이 파일만 커밋, 실제 값은 .env 에)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
PORT=8420
RECEIPT_SECRET=
# 구글 간편 가입 (공개 클라이언트 ID, 비우면 구글 버튼 대신 "준비 중")
GOOGLE_CLIENT_ID=
# 로그인 세션 쿠키 서명 키 (비우면 RECEIPT_SECRET 사용)
SESSION_SECRET=
# 심사용 공용 테스트 계정 (둘 다 채우면 서버 시작 시 계정을 만들거나 비밀번호를 갱신. 탈퇴 불가·가입자 수 집계 제외)
TEST_ACCOUNT_ID=
TEST_ACCOUNT_PASSWORD=
